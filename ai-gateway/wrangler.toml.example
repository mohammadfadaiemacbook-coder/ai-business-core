name = "ai-business-core"
main = "worker.js"
compatibility_date = "2026-10-30"
workers_dev = true
keep_vars = true

[[d1_databases]]
binding = "DB"
database_name = "ai-business-core-db"
database_id = "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID"
migrations_dir = "../migrations"

[vars]
ALLOWED_ORIGIN = "https://mohammadfadaiemacbook-coder.github.io"
APP_PUBLIC_URL = "https://mohammadfadaiemacbook-coder.github.io/ai-business-core/"
